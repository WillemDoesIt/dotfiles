[global]
font = "JetBrainsMono Nerd Font Mono 10"
foreground = "#ffffff"
background = "#090909"
frame_color = "#595959"
frame_width = 2
offset = 8x12
icon_path = "/usr/share/icons/default/index.theme:/usr/share/pixmaps"

[urgency_low]
timeout = 10

[urgency_normal]
timeout = 20

[urgency_critical]
background = "#b20929"
frame_color = "#ff0909"
timeout = 0
